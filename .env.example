HOST=127.0.0.1
PORT=8000
DYFR_DATA_DIR=/srv/draw-your-font-data/public-fonts

# Set to 1 only when the Node server is behind your trusted reverse proxy.
DYFR_TRUST_PROXY=1

# Shared catalog limits: 5 GiB and 10,000 publications by default.
DYFR_MAX_PUBLIC_BYTES=5368709120
DYFR_MAX_PUBLIC_FONTS=10000

# Generate a long random value and keep it private.
DYFR_ADMIN_TOKEN=replace-with-a-long-random-secret
